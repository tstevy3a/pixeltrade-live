# Backend only. Never expose these values to GitHub Pages or browser code.
PIXELTRADE_MODE=SHADOW
PIXELTRADE_GATEWAY_TOKEN=replace-with-a-long-random-token
PIXELTRADE_ALLOWED_ORIGIN=https://tstevy3a.github.io
PIXELTRADE_PORT=3456
AUTO_RUN_ENABLED=false
LIVE_TRADING_ACK=

# Hyperliquid: use a dedicated API wallet with limited collateral.
HYPERLIQUID_ACCOUNT_ADDRESS=0x...
HYPERLIQUID_API_PRIVATE_KEY=0x...

# Same model providers used by Orbit Trading.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# LIVE_MICRO remains fail-closed unless all limits are configured.
MAX_ACCOUNT_EQUITY_USD=100
RISK_PER_TRADE=0.0025
MAX_DAILY_LOSS=0.01
MAX_OPEN_POSITIONS=1
MAX_LEVERAGE=1
MAX_TRADES_PER_DAY=3
